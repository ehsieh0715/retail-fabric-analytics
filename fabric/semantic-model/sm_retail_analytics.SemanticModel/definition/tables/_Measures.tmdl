	measure 'Potential Overstock Flag' =
			
			VAR Stock =
			    [Current Stock On Hand]
			
			VAR RecentUnits =
			    [Recent 30-Day Units]
			
			VAR SupplyDays =
			    [Days of Supply]
			
			RETURN
			    IF (
			        NOT ISBLANK ( Stock )
			            && Stock > 0
			            && (
			                RecentUnits = 0
			                    || SupplyDays >= 60
			            ),
			        1,
			        0
			    )
		formatString: 0
		displayFolder: 03 Inventory
		lineageTag: 1a705bb2-a46d-4f50-8c79-4da31d8c25a9

	measure 'Potential Overstock Position Count' =
			
			VAR StoreProductPositions =
			    CROSSJOIN (
			        VALUES ( dim_store[store_id] ),
			        VALUES ( dim_product[product_id] )
			    )
			RETURN
			    SUMX (
			        StoreProductPositions,
			        CALCULATE ( [Potential Overstock Flag] )
			    )
		formatString: 0
