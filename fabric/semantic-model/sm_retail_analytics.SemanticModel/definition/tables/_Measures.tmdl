	measure 'Recent 30-Day Units' =
			
			VAR EndDate =
			    [Latest Sales Date]
			VAR StartDate =
			    EndDate - 29
			RETURN
			    CALCULATE (
			        [Total Units],
			        REMOVEFILTERS ( dim_date ),
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            StartDate,
			            EndDate
			        )
			    )
		formatString: 0
		displayFolder: 03 Inventory
		lineageTag: c9e00933-1bfc-4a50-a4c6-322074965219

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = IsHidden

	measure 'Average Daily Units - Recent 30 Days' =
			
			DIVIDE (
			    [Recent 30-Day Units],
			    30
			)
		displayFolder: 03 Inventory
		lineageTag: 4138bf29-d6dd-4966-8caa-64e7d6f1d576

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days of Supply' =
			
			VAR Stock =
			    [Current Stock On Hand]
			VAR AverageDailyUnits =
			    [Average Daily Units - Recent 30 Days]
			RETURN
			    IF (
			        AverageDailyUnits > 0,
			        DIVIDE (
			            Stock,
			            AverageDailyUnits
			        )
			    )
		formatString: 0.0
		displayFolder: 03 Inventory
		lineageTag: 3a8255de-4a0a-45ee-92f4-11a9b90ea9e4

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = IsHidden

	measure 'Supply Status' =
			
			VAR Stock =
			    [Current Stock On Hand]
			VAR RecentUnits =
			    [Recent 30-Day Units]
			VAR SupplyDays =
			    [Days of Supply]
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( Stock ),
			            BLANK (),
			
			        Stock = 0 && RecentUnits > 0,
			            "Out of Stock",
			
			        RecentUnits = 0,
			            "No Recent Demand",
			
			        SupplyDays < 3,
			            "Critical",
			
			        SupplyDays < 7,
			            "Warning",
			
			        "Normal"
			    )
		displayFolder: 03 Inventory
		lineageTag: 0d7d6fcb-f593-462c-8828-6dc4d2f43dcf

	measure 'Performance Period Subtitle' =
			
			VAR ReportDate =
			    [Selected Report Date]
			VAR NumberOfDays =
			    [Selected Period Days]
			VAR PreviousEndDate =
			    IF (
			        NumberOfDays = 1,
			        ReportDate - 7,
			        ReportDate - NumberOfDays
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			
			        NumberOfDays = 1,
			            "Performance on "
			                & FORMAT ( ReportDate, "dd MMM yyyy", "en-GB" )
			                & " · compared with "
			                & FORMAT ( PreviousEndDate, "dd MMM yyyy", "en-GB" )
			                & " (same weekday last week)",
			
			        NumberOfDays = 7,
			            "7-day performance through "
			                & FORMAT ( ReportDate, "dd MMM yyyy", "en-GB" )
			                & " · compared with the previous 7 days",
			
			        NumberOfDays = 30,
			            "30-day performance through "
			                & FORMAT ( ReportDate, "dd MMM yyyy", "en-GB" )
			                & " · compared with the previous 30 days",
			
			        NumberOfDays & "-day performance through "
			            & FORMAT ( ReportDate, "dd MMM yyyy", "en-GB" )
			            & " · compared with the previous "
			            & NumberOfDays & " days"
			    )
		displayFolder: 05 Display Text
		lineageTag: 1d3a3405-8f5c-4e37-9b66-46e72d106ccd

	measure 'Revenue - 12 Week Trend' =
			
			VAR ReportDate =
			    [Selected Report Date]
			
			VAR ReportWeekStart =
			    ReportDate
			        - WEEKDAY ( ReportDate, 2 )
			        + 1
			
			VAR TrendStartWeek =
			    ReportWeekStart - 77
			
			VAR AxisWeekStart =
			    SELECTEDVALUE ( dim_date[week_start_date] )
			
			VAR AxisWeekEnd =
			    AxisWeekStart + 6
			
			VAR EffectiveWeekEnd =
			    MIN ( AxisWeekEnd, ReportDate )
			
			VAR IsVisibleWeek =
			    AxisWeekStart >= TrendStartWeek
			        && AxisWeekStart <= ReportWeekStart
			
			RETURN
			    IF (
			        IsVisibleWeek,
			        CALCULATE (
			            [Total Revenue],
			            REMOVEFILTERS ( dim_date ),
			            DATESBETWEEN (
			                dim_date[calendar_date],
			                AxisWeekStart,
			                EffectiveWeekEnd
			            )
			        )
			    )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 02 Period\Revenue
		lineageTag: 99cc64d2-2829-4a92-af11-f977c4e85323

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Store Attention Flag' =
			
			VAR RevenueChange =
			    [Revenue Change %]
			VAR MarginChange =
			    [Gross Margin Period Change pp]
			
			VAR RevenueRequiresAttention =
			    NOT ISBLANK ( RevenueChange )
			        && RevenueChange <= -0.10
			
			VAR MarginRequiresAttention =
			    NOT ISBLANK ( MarginChange )
			        && MarginChange <= -2
			
			RETURN
			    IF (
			        RevenueRequiresAttention
			            || MarginRequiresAttention,
			        1,
			        0
			    )
		formatString: 0
		displayFolder: 04 Attension
		lineageTag: f60d39f3-47ae-4ee5-8a59-a4e1ff277229

	measure 'Stores Requiring Attention Count' =
			
			SUMX (
			    VALUES ( dim_store[store_id] ),
			    [Store Attention Flag]
			)
		formatString: 0
		displayFolder: 04 Attension
		lineageTag: e9c1fa68-0ab9-491e-bb8b-2ad825249553

	measure 'Replenishment Risk Position Count' =
			
			VAR StoreProductPositions =
			    CROSSJOIN (
			        VALUES ( dim_store[store_id] ),
			        VALUES ( dim_product[product_id] )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            StoreProductPositions,
			
			            VAR Stock =
			                CALCULATE (
			                    [Current Stock On Hand]
			                )
			
			            VAR RecentUnits =
			                CALCULATE (
			                    [Recent 30-Day Units]
			                )
			
			            VAR SupplyDays =
			                CALCULATE (
			                    [Days of Supply]
			                )
			
			            RETURN
			                NOT ISBLANK ( Stock )
			                    && RecentUnits > 0
			                    && SupplyDays < 7
			        )
			    )
		formatString: 0
		displayFolder: 03 Inventory
		lineageTag: 5f393e0d-d6a9-4867-a2b9-96177de5fa4a

