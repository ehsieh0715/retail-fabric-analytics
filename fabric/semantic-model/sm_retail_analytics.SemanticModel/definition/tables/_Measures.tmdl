	measure 'Revenue Period Change Amount' =
			
			[Revenue - Selected Period]
			    - [Revenue - Previous Period]
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 02 Period\Revenue
		lineageTag: 6d566cb7-1e82-4469-8460-dc5f8535e96b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue - Comparison Window Trend' =
			
			VAR ReportDate =
			    [Selected Report Date]
			
			VAR NumberOfDays =
			    [Selected Period Days]
			
			VAR ComparisonStartDate =
			    IF (
			        NumberOfDays = 1,
			        ReportDate - 7,
			        ReportDate - ( NumberOfDays * 2 ) + 1
			    )
			
			VAR AxisDate =
			    MAX ( dim_date[calendar_date] )
			
			RETURN
			    IF (
			        AxisDate >= ComparisonStartDate
			            && AxisDate <= ReportDate,
			        [Total Revenue]
			    )
		displayFolder: 02 Period\Revenue
		lineageTag: 1b942204-1255-473d-804e-4445b777d267

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Daily Revenue by Weekday - Current' =
			
			VAR ReportDate =
			    [Selected Report Date]
			
			VAR NumberOfDays =
			    [Selected Period Days]
			
			VAR PeriodStart =
			    ReportDate - NumberOfDays + 1
			
			VAR AxisWeekdays =
			    VALUES ( dim_date[day_of_week_number] )
			
			VAR PeriodDates =
			    CALCULATETABLE (
			        VALUES ( dim_date[calendar_date] ),
			        REMOVEFILTERS ( dim_date ),
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            PeriodStart,
			            ReportDate
			        ),
			        TREATAS (
			            AxisWeekdays,
			            dim_date[day_of_week_number]
			        )
			    )
			
			RETURN
			    AVERAGEX (
			        PeriodDates,
			        CALCULATE ( [Total Revenue] )
			    )
		displayFolder: 02 Period\Revenue
		lineageTag: 2cbc6554-8684-418a-8a84-9b0a9e8944c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Daily Revenue by Weekday - Previous' =
			
			VAR ReportDate =
			    [Selected Report Date]
			
			VAR NumberOfDays =
			    [Selected Period Days]
			
			VAR PreviousPeriodEnd =
			    IF (
			        NumberOfDays = 1,
			        ReportDate - 7,
			        ReportDate - NumberOfDays
			    )
			
			VAR PreviousPeriodStart =
			    PreviousPeriodEnd - NumberOfDays + 1
			
			VAR AxisWeekdays =
			    VALUES ( dim_date[day_of_week_number] )
			
			VAR PeriodDates =
			    CALCULATETABLE (
			        VALUES ( dim_date[calendar_date] ),
			        REMOVEFILTERS ( dim_date ),
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            PreviousPeriodStart,
			            PreviousPeriodEnd
			        ),
			        TREATAS (
			            AxisWeekdays,
			            dim_date[day_of_week_number]
			        )
			    )
			
			RETURN
			    AVERAGEX (
			        PeriodDates,
			        CALCULATE ( [Total Revenue] )
			    )
		displayFolder: 02 Period\Revenue
		lineageTag: 89b1f4b6-318d-4ae5-9aaa-f824be101876

		annotation PBI_FormatHint = {"isGeneralNumber":true}

