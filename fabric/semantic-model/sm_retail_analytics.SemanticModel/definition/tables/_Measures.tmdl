	measure 'Revenue - Selected Period' =
			
			VAR EndDate =
			    [Selected Report Date]
			VAR NumberOfDays =
			    [Selected Period Days]
			VAR StartDate =
			    EndDate - NumberOfDays + 1
			VAR Result =
			    CALCULATE (
			        [Total Revenue],
			        REMOVEFILTERS ( dim_date ),
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            StartDate,
			            EndDate
			        )
			    )
			RETURN
			    COALESCE ( Result, 0 )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 02 Period\Revenue
		lineageTag: 2cad113b-ae50-4534-b417-57f8c8afcf30

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue - Previous Period' =
			
			VAR EndDate =
			    [Selected Report Date]
			VAR NumberOfDays =
			    [Selected Period Days]
			VAR PreviousEndDate =
			    IF (
			        NumberOfDays = 1,
			        EndDate - 7,
			        EndDate - NumberOfDays
			    )
			VAR PreviousStartDate =
			    IF (
			        NumberOfDays = 1,
			        PreviousEndDate,
			        PreviousEndDate - NumberOfDays + 1
			    )
			VAR Result =
			    CALCULATE (
			        [Total Revenue],
			        REMOVEFILTERS ( dim_date ),
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            PreviousStartDate,
			            PreviousEndDate
			        )
			    )
			RETURN
			    COALESCE ( Result, 0 )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: 02 Period\Revenue
		lineageTag: 748e8423-2bdc-4029-900d-b76e679a5d9a

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Revenue Change %' =
			
			DIVIDE (
			    [Revenue - Selected Period]
			        - [Revenue - Previous Period],
			    [Revenue - Previous Period]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02 Period\Revenue
		lineageTag: 6aa66720-393b-445d-a91e-17d168cc92c5

